CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

#enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

#disable BT connection reattempt
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

#enable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Chip shell costs RAM during BLE PASE; enable locally if needed for debug
CONFIG_ENABLE_CHIP_SHELL=n

# Dynamic endpoints (combined or separate Home display):
#   combined: Root + RAC + Humidity + Light
#   separate: Root + Aggregator + 3 bridged endpoints
# Root also consumes a slot; 4 is too low and aborts on later endpoints.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=8

#enable lwIP route hooks
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Button (BOOT = GPIO0 on ESP32-S3-WROOM-1)
CONFIG_BUTTON_PERIOD_TIME_MS=20
CONFIG_BUTTON_LONG_PRESS_TIME_MS=5000

# disable softap by default
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Trim Wi-Fi buffers — Matter + BLE PASE is heap-starved on S3 without PSRAM
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4

# Prefer software coexist so ConnectNetwork can run while CHIPoBLE is still up
CONFIG_SW_COEXIST_ENABLE=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Enable OTA Requestor
CONFIG_ENABLE_OTA_REQUESTOR=y

# Matter project config (Manufacturer / ProductName)
CONFIG_CHIP_PROJECT_CONFIG="main/CHIPProjectConfig.h"

# Disable hardcoded test serial; app generates one (random + MAC suffix)
CONFIG_USE_TEST_SERIAL_NUMBER=""

# Per-device pairing codes via custom CommissionableDataProvider.
# Without this, EXAMPLE (Test) provider always returns 20202021 / 34970112332.
CONFIG_CUSTOM_COMMISSIONABLE_DATA_PROVIDER=y
# CONFIG_EXAMPLE_COMMISSIONABLE_DATA_PROVIDER is not set
CONFIG_ENABLE_TEST_SETUP_PARAMS=n

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# Increase LwIP IPv6 address number to 6 (MAX_FABRIC + 1)
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# ESP32-S3-WROOM-1-N16 defaults (see main/board_pins.h)
CONFIG_SHT30_I2C_SDA_PIN=8
CONFIG_SHT30_I2C_SCL_PIN=9
CONFIG_WS2812_GPIO=10

# LVGL (via esp_lvgl_port)
CONFIG_LV_COLOR_DEPTH_16=y
# GC9A01 SPI needs RGB565 byte swap; without this, gradients and AA fonts
# render as colored bands / garbled glyphs while pure B/W QR still looks OK.
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y
